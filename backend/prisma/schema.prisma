// Doctor Appointment Management System — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
  INSURANCE
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_RESCHEDULED
  DOCTOR_UNAVAILABLE
  PRESCRIPTION_UPLOADED
  PAYMENT_SUCCESS
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          Role       @default(PATIENT)
  phone         String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  avatarUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  doctor         Doctor?
  patient        Patient?
  staff          Staff?
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("token_blacklist")
}

// ─── Clinic / Hospital Structure ─────────────────────────────────────────────

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  doctors Doctor[]

  @@index([slug])
  @@index([deletedAt])
  @@map("departments")
}

// ─── Doctors ─────────────────────────────────────────────────────────────────

model Doctor {
  id               String    @id @default(cuid())
  userId           String    @unique
  departmentId     String
  qualification    String
  experience       Int       @default(0)
  consultationFee  Decimal   @db.Decimal(10, 2)
  licenseNumber    String    @unique
  bio              String?
  photo            String?
  isAvailable      Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department         @relation(fields: [departmentId], references: [id])
  schedules     DoctorSchedule[]
  holidays      DoctorHoliday[]
  appointments  Appointment[]
  prescriptions Prescription[]
  reviews       Review[]

  @@index([departmentId])
  @@index([deletedAt])
  @@map("doctors")
}

model DoctorSchedule {
  id        String    @id @default(cuid())
  doctorId  String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  slotMins  Int       @default(30)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
  @@map("doctor_schedules")
}

model DoctorHoliday {
  id        String   @id @default(cuid())
  doctorId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId])
  @@map("doctor_holidays")
}

// ─── Patients ────────────────────────────────────────────────────────────────

model Patient {
  id               String     @id @default(cuid())
  userId           String     @unique
  bloodGroup       BloodGroup @default(UNKNOWN)
  dob              DateTime?  @db.Date
  gender           Gender?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalHistory   String?
  insuranceProvider String?
  insuranceNumber  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  prescriptions Prescription[]
  reviews       Review[]
  documents     PatientDocument[]

  @@index([deletedAt])
  @@map("patients")
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  title      String
  fileUrl    String
  fileType   String?
  uploadedAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_documents")
}

// ─── Staff ───────────────────────────────────────────────────────────────────

model Staff {
  id        String    @id @default(cuid())
  userId    String    @unique
  designation String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("staff")
}

// ─── Appointments ────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  doctorId        String
  patientId       String
  appointmentDate DateTime          @db.Date
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING)
  reason          String?
  notes           String?
  queueNumber     Int?
  cancelledReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  prescription  Prescription?
  bill          Bill?

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
  @@index([deletedAt])
  @@map("appointments")
}

// ─── Prescriptions ───────────────────────────────────────────────────────────

model Prescription {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  doctorId      String
  patientId     String
  diagnosis     String
  medicines     Json
  tests         Json?
  notes         String?
  followupDate  DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([doctorId])
  @@index([patientId])
  @@map("prescriptions")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Bill {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  billNumber    String        @unique
  consultationFee Decimal     @db.Decimal(10, 2) @default(0)
  medicineCharges Decimal     @db.Decimal(10, 2) @default(0)
  labCharges    Decimal       @db.Decimal(10, 2) @default(0)
  otherCharges  Decimal       @db.Decimal(10, 2) @default(0)
  discount      Decimal       @db.Decimal(10, 2) @default(0)
  tax           Decimal       @db.Decimal(10, 2) @default(0)
  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@index([billNumber])
  @@map("bills")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  doctorId  String
  patientId String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
  @@index([doctorId])
  @@map("reviews")
}

// ─── System Settings & Audit ─────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
